diff --git a/src/services/ratings.js b/src/services/ratings.js
new file mode 100644
index 0000000..6d25f9a
--- /dev/null
+++ b/src/services/ratings.js
@@ -0,0 +1,24 @@
+import * as store from "../db/store.js"
+import { NotFoundError } from "../utils/errors.js"
+
+export function rateBook(bookId, memberId, stars) {
+  if (stars < 1 || stars > 5) throw new RangeError("stars must be between 1 and 5")
+
+  // Compose rating id as 'bookId|memberId' to allow easy lookups
+  const ratingId = `${bookId}|${memberId}`
+  const rating = { id: ratingId, bookId, memberId, stars }
+
+  // Add or update the rating
+  store.insert("ratings", rating)
+  return rating
+}
+
+export function getRatingsStats(bookId) {
+  const ratings = store.where("ratings", (r) => r.bookId === bookId)
+  if (ratings.length === 0) return { average: null, count: 0 }
+
+  const sum = ratings.reduce((acc, r) => acc + r.stars, 0)
+  const average = Math.round((sum / ratings.length) * 10) / 10
+
+  return { average, count: ratings.length }
+}
diff --git a/src/services/reports.js b/src/services/reports.js
new file mode 100644
index 0000000..252b114
--- /dev/null
+++ b/src/services/reports.js
@@ -0,0 +1,14 @@
+import * as store from "../db/store.js"
+import { getBook } from "./catalog.js"
+
+export function getPopularBooks(limit = 5) {
+  const borrowCounts = new Map()
+  for (const loan of store.all("loans")) {
+    borrowCounts.set(loan.bookId, (borrowCounts.get(loan.bookId) ?? 0) + 1)
+  }
+  const popular = [...borrowCounts.entries()]
+    .sort((a, b) => b[1] - a[1])
+    .slice(0, limit)
+    .map(([bookId, count]) => ({ book: getBook(bookId), borrowCount: count }))
+  return popular
+}
